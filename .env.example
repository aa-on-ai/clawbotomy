# Clawbotomy benchmark environment variables
# The Node benchmark reads its process environment and does not automatically
# load this file. Export only the keys you need in your shell, or load them
# with your local secret manager. Never commit real keys.

# ===================
# AI Provider API Keys
# ===================

# Anthropic (Claude models)
ANTHROPIC_API_KEY=your_anthropic_key

# OpenAI (GPT models)
OPENAI_API_KEY=your_openai_key

# Google (Gemini models)
GOOGLE_API_KEY=your_google_key

# Optional provider/local request timeout in milliseconds (1000-600000)
# CLAWBOTOMY_REQUEST_TIMEOUT_MS=300000
