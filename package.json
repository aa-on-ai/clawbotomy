{
  "name": "clawbotomy",
  "version": "0.1.0",
  "description": "Open-source behavior checkups for configured OpenClaw and Hermes agents with synthetic tools and local evidence review.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "test:ui": "playwright test",
    "bench": "node bench/index.js",
    "inbox": "node inbox/index.js",
    "agent:evaluate": "node inbox/agent-evaluate.js",
    "agent:preflight": "node inbox/agent-preflight.js",
    "agent:repeat": "node inbox/repeated-session-evidence.js",
    "compat:watchdog": "node compatibility/watchdog.mjs",
    "evidence": "node bench/evidence-cli.js",
    "test": "npm run test:core",
    "test:core": "node --experimental-strip-types --test tests/*.test.js",
    "test:openclaw": "node --experimental-strip-types --test integrations/openclaw/*.test.mjs",
    "claims:check": "node --experimental-strip-types --test tests/claim-registry.test.js",
    "verify:node": "npm run test:core && npm run test:openclaw && npm run lint && npm run build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.3.1",
    "next": "15.5.21",
    "openai": "^6.17.0",
    "radix-ui": "^1.4.3",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "15.5.21",
    "postcss": "8.5.22",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "express-rate-limit": "8.5.1",
    "fast-uri": "3.1.4",
    "ip-address": "10.1.1",
    "qs": "6.15.2",
    "sharp": "0.35.3",
    "ws": "8.21.1",
    "next": {
      "postcss": "8.5.22"
    }
  }
}
