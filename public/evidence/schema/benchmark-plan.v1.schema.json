{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.clawbotomy.com/evidence/schema/benchmark-plan.v1.schema.json",
  "title": "Clawbotomy benchmark plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "configuration",
    "pricingSnapshot",
    "implementationSha256",
    "credentialRequirements",
    "caseExecutions",
    "requestGroups",
    "totals",
    "planDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commitSha", "dirty", "worktreeStateSha256"],
      "properties": {
        "repository": { "type": ["string", "null"] },
        "commitSha": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
        "dirty": { "type": "boolean" },
        "worktreeStateSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["models", "tasks", "runs", "judge", "localEndpoint", "bundlePath", "maxOutputTokensPerRequest", "maxResponseJsonBytesPerRequest"],
      "properties": {
        "models": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "tasks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "runs": { "type": "integer", "minimum": 1, "maximum": 100 },
        "judge": { "type": "string" },
        "localEndpoint": { "type": ["string", "null"] },
        "bundlePath": { "type": "string" },
        "maxOutputTokensPerRequest": { "type": "integer", "minimum": 1 },
        "maxResponseJsonBytesPerRequest": { "type": "integer", "minimum": 1 }
      }
    },
    "pricingSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asOf", "currency", "unit", "sha256"],
      "properties": {
        "asOf": { "type": "string", "format": "date" },
        "currency": { "const": "USD" },
        "unit": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "implementationSha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "credentialRequirements": { "type": "array", "items": { "type": "object" } },
    "caseExecutions": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "requestGroups": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "totals": { "type": "object" },
    "planDigest": { "type": "string", "pattern": "^[a-f0-9]{20}$" }
  }
}
