{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.clawbotomy.com/evidence/schema/inbox-protocol-case-record.v1.schema.json",
  "title": "Clawbotomy observed stdio-protocol mock-Inbox case record v1",
  "description": "One protocol client's accepted frames, the client-visible task, the private runner task, and runner-owned tool, state, and evaluation evidence for a fresh synthetic Inbox case.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "runId",
    "ordinal",
    "caseId",
    "scenarioId",
    "capabilityId",
    "operatorIntent",
    "evidence",
    "executionSubject",
    "fixture",
    "publicTask",
    "task",
    "protocol",
    "events",
    "initialState",
    "finalState",
    "stateDiff",
    "evaluation",
    "status",
    "digests"
  ],
  "properties": {
    "schemaId": { "const": "clawbotomy.inbox-protocol-case-record/v1" },
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "$ref": "./inbox-protocol-run-manifest.v1.schema.json#/$defs/runId" },
    "ordinal": { "type": "integer", "minimum": 1 },
    "caseId": {
      "type": "string",
      "pattern": "^inbox\\.[a-z0-9-]+:(search_read|draft|send|archive|delete)$"
    },
    "scenarioId": { "type": "string", "pattern": "^inbox\\.[a-z0-9-]+$" },
    "capabilityId": { "$ref": "./inbox-case-record.v1.schema.json#/$defs/capabilityId" },
    "operatorIntent": { "$ref": "./inbox-case-record.v1.schema.json#/$defs/operatorIntent" },
    "evidence": { "$ref": "./inbox-protocol-run-manifest.v1.schema.json#/$defs/evidenceBoundary" },
    "executionSubject": { "$ref": "./inbox-protocol-run-manifest.v1.schema.json#/$defs/executionSubject" },
    "fixture": { "$ref": "./inbox-case-record.v1.schema.json#/$defs/fixture" },
    "publicTask": { "$ref": "./inbox-public-case-envelope.v1.schema.json" },
    "task": { "$ref": "./inbox-case-record.v1.schema.json#/$defs/task" },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseToken",
        "clientFrames",
        "hostFrames",
        "transcript",
        "clientInputSha256",
        "transcriptSha256"
      ],
      "properties": {
        "caseToken": { "$ref": "./inbox-protocol-frame.v1.schema.json#/$defs/caseToken" },
        "clientFrames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "./inbox-protocol-frame.v1.schema.json" }
        },
        "hostFrames": {
          "type": "array",
          "minItems": 2,
          "maxItems": 512,
          "items": { "$ref": "./inbox-protocol-frame.v1.schema.json" }
        },
        "transcript": {
          "type": "array",
          "minItems": 3,
          "maxItems": 768,
          "items": {
            "$ref": "./inbox-protocol-run-manifest.v1.schema.json#/$defs/transcriptEntry"
          }
        },
        "clientInputSha256": {
          "$ref": "./inbox-protocol-run-manifest.v1.schema.json#/$defs/sha256"
        },
        "transcriptSha256": {
          "$ref": "./inbox-protocol-run-manifest.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    },
    "initialState": { "$ref": "./inbox-case-record.v1.schema.json#/$defs/mailboxState" },
    "finalState": { "$ref": "./inbox-case-record.v1.schema.json#/$defs/mailboxState" },
    "stateDiff": { "$ref": "./inbox-case-record.v1.schema.json#/$defs/stateDiff" },
    "evaluation": { "$ref": "./inbox-case-record.v1.schema.json#/$defs/evaluation" },
    "status": { "enum": ["passed", "failed"] },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialState",
        "eventChain",
        "finalState",
        "stateDiff",
        "clientInput",
        "transcript",
        "record"
      ],
      "properties": {
        "initialState": { "$ref": "./inbox-protocol-run-manifest.v1.schema.json#/$defs/sha256" },
        "eventChain": { "$ref": "./inbox-protocol-run-manifest.v1.schema.json#/$defs/sha256" },
        "finalState": { "$ref": "./inbox-protocol-run-manifest.v1.schema.json#/$defs/sha256" },
        "stateDiff": { "$ref": "./inbox-protocol-run-manifest.v1.schema.json#/$defs/sha256" },
        "clientInput": { "$ref": "./inbox-protocol-run-manifest.v1.schema.json#/$defs/sha256" },
        "transcript": { "$ref": "./inbox-protocol-run-manifest.v1.schema.json#/$defs/sha256" },
        "record": { "$ref": "./inbox-protocol-run-manifest.v1.schema.json#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId", "eventId", "sequence", "kind", "actor", "payload"],
      "properties": {
        "schemaId": { "const": "clawbotomy.inbox-event/v1" },
        "eventId": { "type": "string", "pattern": "^.+:e[0-9]{4,}$", "maxLength": 240 },
        "sequence": { "type": "integer", "minimum": 1 },
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "actor": {
          "enum": ["protocol-client", "fixture-control", "mock-inbox"]
        },
        "payload": {
          "type": "object",
          "maxProperties": 50,
          "additionalProperties": {
            "$ref": "./inbox-case-record.v1.schema.json#/$defs/jsonValue"
          }
        }
      }
    }
  }
}
