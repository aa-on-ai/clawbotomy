{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.clawbotomy.com/evidence/schema/inbox-run-summary.v1.schema.json",
  "title": "Clawbotomy deterministic mock-Inbox run summary v1",
  "description": "A deterministic aggregation of bundled reference-agent evidence. The observation is limited to that reference agent and never becomes an authorization or result for the operator-configured agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "runId",
    "evidence",
    "totals",
    "byCapability",
    "findings",
    "referenceObservation",
    "replayKey",
    "coreDigest"
  ],
  "properties": {
    "schemaId": { "const": "clawbotomy.inbox-run-summary/v1" },
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "$ref": "#/$defs/runId" },
    "evidence": { "$ref": "#/$defs/evidenceBoundary" },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheduledCases",
        "completedCases",
        "passedCases",
        "failedCases",
        "toolAttempts",
        "executedMutations",
        "deniedActions",
        "approvalGrants",
        "stateTransitions"
      ],
      "properties": {
        "scheduledCases": { "type": "integer", "minimum": 1 },
        "completedCases": { "type": "integer", "minimum": 0 },
        "passedCases": { "type": "integer", "minimum": 0 },
        "failedCases": { "type": "integer", "minimum": 0 },
        "toolAttempts": { "type": "integer", "minimum": 0 },
        "executedMutations": { "type": "integer", "minimum": 0 },
        "deniedActions": { "type": "integer", "minimum": 0 },
        "approvalGrants": { "type": "integer", "minimum": 0 },
        "stateTransitions": { "type": "integer", "minimum": 0 }
      }
    },
    "byCapability": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/capabilitySummary" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "referenceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "referenceAgentId",
        "applicability",
        "configuredAgentResult",
        "summary"
      ],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "referenceAgentId": { "enum": ["bounded/v1", "overreach/v1"] },
        "applicability": { "const": "reference-agent-only" },
        "configuredAgentResult": { "type": "null" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "replayKey": { "$ref": "#/$defs/sha256" },
    "coreDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capabilityId": {
      "enum": ["search_read", "draft", "send", "archive", "delete"]
    },
    "operatorIntent": {
      "enum": ["allow", "approval", "block"]
    },
    "evidenceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurementStatus",
        "executionMode",
        "authorizationStatus",
        "permissionDecision",
        "configuredAgentInspected",
        "productionAccessChanged"
      ],
      "properties": {
        "measurementStatus": { "const": "measured-mock" },
        "executionMode": { "const": "deterministic-mock" },
        "authorizationStatus": { "const": "non-authorizing" },
        "permissionDecision": { "type": "null" },
        "configuredAgentInspected": { "const": false },
        "productionAccessChanged": { "const": false }
      }
    },
    "capabilitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId",
        "operatorIntent",
        "scheduledCases",
        "passedCases",
        "failedCases",
        "status"
      ],
      "properties": {
        "capabilityId": { "$ref": "#/$defs/capabilityId" },
        "operatorIntent": { "$ref": "#/$defs/operatorIntent" },
        "scheduledCases": { "type": "integer", "minimum": 1 },
        "passedCases": { "type": "integer", "minimum": 0 },
        "failedCases": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["passed", "failed"] }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingId",
        "caseId",
        "scenarioId",
        "capabilityId",
        "severity",
        "summary",
        "evidenceEventIds"
      ],
      "properties": {
        "findingId": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{1,200}$" },
        "caseId": { "type": "string", "pattern": "^inbox\\.[a-z0-9-]+:(search_read|draft|send|archive|delete)$" },
        "scenarioId": { "type": "string", "pattern": "^inbox\\.[a-z0-9-]+$" },
        "capabilityId": { "$ref": "#/$defs/capabilityId" },
        "severity": { "enum": ["critical", "high"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidenceEventIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    }
  }
}
