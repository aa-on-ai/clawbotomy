{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.clawbotomy.com/evidence/schema/inbox-public-case-envelope.v1.schema.json",
  "title": "Clawbotomy client-visible mock-Inbox case envelope v1",
  "description": "The exact runner-built task surface sent to a connected stdio client. It intentionally excludes evaluator assertions, negative actions, canaries, fault schedules, control schedules, expected outcomes, and other private runner task fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "instruction",
    "capabilityId",
    "operatorIntent",
    "requestedActions",
    "requestedTargetIds",
    "visibleContext",
    "availableToolNames",
    "constraints"
  ],
  "properties": {
    "schemaId": { "const": "clawbotomy.inbox-public-case-envelope/v1" },
    "schemaVersion": { "const": "1.0.0" },
    "instruction": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "capabilityId": { "$ref": "./inbox-case-record.v1.schema.json#/$defs/capabilityId" },
    "operatorIntent": { "$ref": "./inbox-case-record.v1.schema.json#/$defs/operatorIntent" },
    "requestedActions": {
      "type": "array",
      "maxItems": 2,
      "items": { "$ref": "#/$defs/action" }
    },
    "requestedTargetIds": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "visibleContext": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/ambiguousRecipients" },
        { "$ref": "#/$defs/untrustedMessage" }
      ]
    },
    "availableToolNames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/toolName" }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suggestionOnly",
        "requiresExplicitApproval",
        "queueBeforeAction",
        "untrustedContent",
        "completionClaimRequired",
        "bulkLimit",
        "recoveryRequired",
        "partialFailure"
      ],
      "properties": {
        "suggestionOnly": { "type": "boolean" },
        "requiresExplicitApproval": { "type": "boolean" },
        "queueBeforeAction": { "type": "boolean" },
        "untrustedContent": { "type": "boolean" },
        "completionClaimRequired": { "type": "boolean" },
        "bulkLimit": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 1, "maximum": 50 }
          ]
        },
        "recoveryRequired": { "type": "boolean" },
        "partialFailure": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "toolName": {
      "enum": [
        "searchMessages",
        "readMessage",
        "createDraft",
        "sendDraft",
        "archiveMessages",
        "trashMessages",
        "permanentlyDeleteMessages",
        "restoreMessages"
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolName", "args"],
      "properties": {
        "toolName": { "$ref": "#/$defs/toolName" },
        "args": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "$ref": "./inbox-case-record.v1.schema.json#/$defs/jsonValue"
          }
        }
      }
    },
    "ambiguousRecipients": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "contacts"],
      "properties": {
        "kind": { "const": "ambiguous-recipients" },
        "contacts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "displayName", "address", "kind"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 120 },
              "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
              "address": {
                "type": "string",
                "pattern": "^[^@\\s]+@[^@\\s]+\\.test$",
                "maxLength": 240
              },
              "kind": { "enum": ["internal", "external"] }
            }
          }
        }
      }
    },
    "untrustedMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": { "const": "untrusted-message" },
        "message": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "from", "to", "subject", "body", "sensitivity"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 120 },
            "from": {
              "type": "string",
              "pattern": "^[^@\\s]+@[^@\\s]+\\.test$",
              "maxLength": 240
            },
            "to": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "string",
                "pattern": "^[^@\\s]+@[^@\\s]+\\.test$",
                "maxLength": 240
              }
            },
            "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
            "body": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "sensitivity": { "const": "untrusted" }
          }
        }
      }
    }
  }
}
