{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.clawbotomy.com/evidence/schema/inbox-protocol-run-summary.v1.schema.json",
  "title": "Clawbotomy observed stdio-protocol mock-Inbox run summary v1",
  "description": "A non-authorizing aggregation of one connected stdio client's observed frames and resulting synthetic Inbox behavior. Client identity and its relationship to a deployed agent remain self-asserted and unauthenticated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "runId",
    "evidence",
    "totals",
    "byCapability",
    "findings",
    "protocolObservation",
    "replayKey",
    "coreDigest"
  ],
  "properties": {
    "schemaId": { "const": "clawbotomy.inbox-protocol-run-summary/v1" },
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "$ref": "./inbox-protocol-run-manifest.v1.schema.json#/$defs/runId" },
    "evidence": { "$ref": "./inbox-protocol-run-manifest.v1.schema.json#/$defs/evidenceBoundary" },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheduledCases",
        "completedCases",
        "passedCases",
        "failedCases",
        "toolAttempts",
        "executedMutations",
        "deniedActions",
        "approvalGrants",
        "stateTransitions"
      ],
      "properties": {
        "scheduledCases": { "type": "integer", "minimum": 1 },
        "completedCases": { "type": "integer", "minimum": 0 },
        "passedCases": { "type": "integer", "minimum": 0 },
        "failedCases": { "type": "integer", "minimum": 0 },
        "toolAttempts": { "type": "integer", "minimum": 0 },
        "executedMutations": { "type": "integer", "minimum": 0 },
        "deniedActions": { "type": "integer", "minimum": 0 },
        "approvalGrants": { "type": "integer", "minimum": 0 },
        "stateTransitions": { "type": "integer", "minimum": 0 }
      }
    },
    "byCapability": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "$ref": "./inbox-run-summary.v1.schema.json#/$defs/capabilitySummary" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "./inbox-run-summary.v1.schema.json#/$defs/finding" }
    },
    "protocolObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "executionSubjectId",
        "applicability",
        "identityAssurance",
        "configuredAgentResult",
        "summary"
      ],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "executionSubjectId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "applicability": { "const": "observed-protocol-session-only" },
        "identityAssurance": { "const": "self-asserted" },
        "configuredAgentResult": { "type": "null" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1200 }
      }
    },
    "replayKey": { "$ref": "./inbox-protocol-run-manifest.v1.schema.json#/$defs/sha256" },
    "coreDigest": { "$ref": "./inbox-protocol-run-manifest.v1.schema.json#/$defs/sha256" }
  }
}
