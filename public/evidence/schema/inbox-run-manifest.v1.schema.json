{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.clawbotomy.com/evidence/schema/inbox-run-manifest.v1.schema.json",
  "title": "Clawbotomy deterministic mock-Inbox run manifest v1",
  "description": "Manifest for a completed, deterministic execution of a bundled reference agent against the synthetic Clawbotomy mock Inbox. It is non-authorizing and says nothing about an operator-configured agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "runId",
    "lifecycle",
    "evidence",
    "plan",
    "referenceAgent",
    "implementationSha256",
    "fixture",
    "execution",
    "replay",
    "coreDigest"
  ],
  "properties": {
    "schemaId": { "const": "clawbotomy.inbox-run-manifest/v1" },
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "$ref": "#/$defs/runId" },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "const": "complete" }
      }
    },
    "evidence": { "$ref": "#/$defs/evidenceBoundary" },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "sha256"],
      "properties": {
        "document": { "$ref": "./inbox-preflight-plan.v1.schema.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "referenceAgent": { "$ref": "#/$defs/referenceAgent" },
    "implementationSha256": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "tools", "evaluator", "referenceAgent", "fixture", "plan", "canonical", "contract", "pack"],
      "properties": {
        "runner": { "$ref": "#/$defs/sha256" },
        "tools": { "$ref": "#/$defs/sha256" },
        "evaluator": { "$ref": "#/$defs/sha256" },
        "referenceAgent": { "$ref": "#/$defs/sha256" },
        "fixture": { "$ref": "#/$defs/sha256" },
        "plan": { "$ref": "#/$defs/sha256" },
        "canonical": { "$ref": "#/$defs/sha256" },
        "contract": { "$ref": "#/$defs/sha256" },
        "pack": { "$ref": "#/$defs/sha256" }
      }
    },
    "fixture": { "$ref": "#/$defs/fixture" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseCount", "casesFile", "summaryFile", "networkRequests", "realInboxConnections"],
      "properties": {
        "caseCount": { "type": "integer", "minimum": 1 },
        "casesFile": { "const": "cases.jsonl" },
        "summaryFile": { "const": "summary.json" },
        "networkRequests": { "const": 0 },
        "realInboxConnections": { "const": 0 }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "deterministic"],
      "properties": {
        "key": { "$ref": "#/$defs/sha256" },
        "deterministic": { "const": true }
      }
    },
    "coreDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidenceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurementStatus",
        "executionMode",
        "authorizationStatus",
        "permissionDecision",
        "configuredAgentInspected",
        "productionAccessChanged"
      ],
      "properties": {
        "measurementStatus": { "const": "measured-mock" },
        "executionMode": { "const": "deterministic-mock" },
        "authorizationStatus": { "const": "non-authorizing" },
        "permissionDecision": { "type": "null" },
        "configuredAgentInspected": { "const": false },
        "productionAccessChanged": { "const": false }
      }
    },
    "referenceAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind", "applicability", "configurationFingerprint"],
      "properties": {
        "id": { "enum": ["bounded/v1", "overreach/v1"] },
        "version": { "const": "1.0.0" },
        "kind": { "const": "built-in-reference" },
        "applicability": { "const": "reference-agent-only" },
        "configurationFingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId", "version", "sha256"],
      "properties": {
        "schemaId": { "const": "clawbotomy.mock-inbox-state/v1" },
        "version": { "const": "1.0.0" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
